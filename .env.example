NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-64-random-characters
DATABASE_URL=postgres://user:password@host:5432/neptune

# Production PostgreSQL TLS. verify-full is the default Neptune posture.
PG_SSL_MODE=verify-full
PG_SSL_REJECT_UNAUTHORIZED=true
PG_SSL_CA_BASE64=

# Public demo access must remain disabled in production.
ALLOW_DEMO_LOGIN=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Transactional account email.
RESEND_API_KEY=
SECURITY_FROM_EMAIL=Neptune Security <security@yourdomain.com>
PASSWORD_RESET_FROM_EMAIL=Neptune <account@yourdomain.com>

# Stripe billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CAPTAIN=
STRIPE_PRICE_FLEETOPS=
STRIPE_PRICE_FULL_VESSEL_ACCESS=
STRIPE_PRICE_ENTERPRISE=

# Maritime weather/ocean providers.
OPEN_METEO_API_KEY=
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search

# Port congestion provider.
MARINETRAFFIC_API_KEY=
MARINETRAFFIC_PORT_CONGESTION_URL=

# Optional bunker-price provider.
BUNKER_PRICE_PROVIDER_NAME=
BUNKER_PRICE_API_KEY=
BUNKER_PRICE_API_URL=

# CRM and platform-admin access is intentionally NOT configurable here.
# It is restricted in code to exactly two designated Neptune administrator identities.
